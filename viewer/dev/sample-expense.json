 "excerpts": {
  "ev_060b12c0208e74541c9309cf": "amount >= THRESHOLD",
  "ev_0cd4dba36aa2ccd8b30bb707": "router.post(\"/reports/{report_id}/approve\")",
  "ev_0e97c65620c2cb4e241f3609": "load_report(report_id)",
  "ev_27ab739514bebed877e2201f": "amount > THRESHOLD",
  "ev_2d227a950a3159474b9b6ef1": "raise ValueError(\"report is not waiting for approval\")",
  "ev_3a3c5f6f744b324fa4dced1b": "router.post(\"/reports\")",
  "ev_4862627c6c3f1fd4cc104578": "save_status(report[\"id\"], \"pending_approval\")",
  "ev_502f7f36452934a1cc846126": "async def test_submit_report_status(amount):\n    result = await submit_report({\"id\": \"r1\", \"amount\": amount})\n    assert result[\"status\"] in {\"approved\", \"pending_approval\"}",
  "ev_69b58696ac53bfca08e609ec": "report[\"status\"] != \"pending_approval\"",
  "ev_71260961e40457f8b321f059": "while True",
  "ev_949ca4731dde1f1209603971": "save_status(report[\"id\"], \"approved\")",
  "ev_9842c88bb717d91b4af3f744": "return {\"status\": \"approved\", \"id\": report_id}",
  "ev_985f0daed8a9e90610999cbc": "return {\"status\": \"pending_approval\", \"review\": verdict}",
  "ev_c508f9dad8de858381427c3f": "review_with_model(report)",
  "ev_cb1df53f16ee5b1327d9f493": "return {\"status\": \"approved\"}",
  "ev_cef70a0999c303b02d0245ab": "save_status(report_id, \"approved\")",
  "ev_e3833282c1443c47fbfd7287": "client.responses.create(model=\"gpt-5\", input=str(report))",
  "ev_f356513531a58361e41df877": "    while True:\n        response = await client.responses.create(model=\"gpt-5\", input=str(report))\n        if response.output_text:\n            return response.output_text",
  "ev_297adc472903254de1351406": "THRESHOLD = 100\n\n\n@router.post(\"/reports\")\nasync def submit_report(report):\n    amount = report[\"amount\"]\n    logger.info(\"report received\")\n    if amount > THRESHOLD:\n        verdict = await review_with_model(report)\n        save_status(report[\"id\"], \"pending_approval\")\n        return {\"status\": \"pending_approval\", \"review\": verdict}\n    save_status(report[\"id\"], \"approved\")\n    return {\"status\": \"approved\"}",
  "ev_6c05f7cc2d600a85bef654fa": "async def review_with_model(report):\n    while True:\n        response = await client.responses.create(model=\"gpt-5\", input=str(report))\n        if response.output_text:\n            return response.output_text"
 },
